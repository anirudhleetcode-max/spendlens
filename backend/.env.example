# Copy to backend/.env and edit. Never commit .env.

# development | production. Production refuses to start without a real JWT_SECRET.
ENV=development

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=spendlens

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left as a placeholder, development runs use a random secret per process (you get logged out on restart).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Windows: full path to tesseract.exe if it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

MAX_UPLOAD_MB=8
# Seconds allowed per Tesseract call. 30 is fine on a normal CPU; raise it on a slow shared
# instance (Render's free tier needs ~120 for a full-size photo).
OCR_TIMEOUT_S=30
# unsaved scans are deleted after this many hours
ORPHAN_RECEIPT_HOURS=24
# failed sign-ins allowed per email + IP within the window
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# comma-separated emails allowed to retrain the shared category model
ADMIN_EMAILS=
# retrain the category model in the background if the saved file can't be loaded
AUTO_REBUILD_MODEL=true
# MODEL_PATH=ml/artifacts/category_model.joblib
